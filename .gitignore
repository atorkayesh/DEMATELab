# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Local environment files (commit only .env.example)
.env

# Files exported from the dev Docker container (the folder itself is kept, so Docker
# never creates it as root on Linux)
qt-app/exports/*
!qt-app/exports/.gitkeep

# The API pins its Python version (some global ignores drop .python-version)
!apps/api/.python-version
