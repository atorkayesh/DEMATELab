# Copy to DEMATELab/.env and adjust. Read by docker-compose-dev.yml (optional) and
# docker-compose-prod.yml (required). Both setups share this file, so a VNC_PASSWORD set
# for prod also password-protects the dev session.

# Password for the browser (noVNC) session. Required in production; leave empty in dev
# to connect without a password. VNC only checks the first 8 characters, and the session
# is not encrypted: expose it beyond localhost only behind a TLS reverse proxy.
VNC_PASSWORD=

# Virtual screen size and colour depth (WIDTHxHEIGHTxDEPTH). The app window is 1400x900.
SCREEN_GEOMETRY=1600x1000x24

# Host port for the browser session (dev and prod). Defaults to 6080. make applies it;
# with plain docker compose, add --env-file DEMATELab/.env so compose reads it.
# NOVNC_PORT=6080

# Dev only: poll for source changes instead of relying on file events. Docker Desktop's
# default WSL2 backend on Windows already polls; set this if dev reload doesn't trigger
# (e.g. Windows with the Hyper-V backend). Costs a little CPU.
# WATCHFILES_FORCE_POLLING=true
