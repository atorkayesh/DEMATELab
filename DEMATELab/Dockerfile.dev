# Development image: dependencies (including the dev group) are baked in, the source is
# bind-mounted by docker-compose-dev.yml, and the GUI restarts when Python files change.
# trixie is required: PySide6 6.12 aarch64 wheels need glibc >= 2.39 (bookworm ships 2.36).
FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    QT_QPA_PLATFORM=xcb \
    APP_MODE=dev

# Qt/X11 runtime libraries, a virtual display, a window manager, and the VNC/noVNC stack.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    xvfb x11vnc openbox novnc websockify \
    fonts-dejavu-core fontconfig \
    libgl1 libegl1 libglib2.0-0t64 libdbus-1-3 libfontconfig1 \
    libxkbcommon0 libxkbcommon-x11-0 libx11-xcb1 libxrender1 libxi6 libsm6 libice6 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libxcb-xfixes0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=astral/uv:0.12.10 /uv /uvx /bin/

# The app runs as this user. At start-up, start.sh gives it the UID/GID of the exports
# folder's owner, so bind-mounted exports stay writable on Linux without a rebuild.
# Code and dependencies stay root-owned (read-only to app): the container starts as root.
RUN useradd --create-home --uid 1000 --user-group app \
    && mkdir -p /app /opt/venv /workspace/exports /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && ln -s /app/assets /workspace/assets \
    && chown app:app /workspace /workspace/exports

COPY docker/index.html /usr/share/novnc/index.html
COPY --chmod=755 docker/start.sh /usr/local/bin/dematelab-start
# Strip CRLF in case the script was checked out or edited with Windows line endings.
RUN sed -i 's/\r$//' /usr/local/bin/dematelab-start

WORKDIR /app

# Install dependencies first so source edits don't invalidate this layer.
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-install-project

COPY . /app/
RUN uv sync --frozen

EXPOSE 6080

# start.sh runs as root only to match the app user to the exports owner, then drops to it.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/dematelab-start"]
