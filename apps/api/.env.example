# API environment variables (validated in config/settings_config.py).
# Copy to apps/api/.env. Docker Compose loads this file into the api container and overrides
# APP_ENV; everything else is used as written here.
# AI provider keys are NOT configured here: users enter them per request in the web app.

# Environment: development or production (set by Compose when running in Docker)
APP_ENV=development

# Comma-separated list of allowed CORS origins.
# Development: the web app's origin. Production (VPS): the public origin, e.g. https://<domain>.
CORS_ORIGINS=http://localhost:3000

# Gunicorn worker count, used by the production image only
WEB_CONCURRENCY=2
