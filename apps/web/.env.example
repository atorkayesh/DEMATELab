# Web environment variables (validated in src/env.ts).
# Copy to apps/web/.env. Docker Compose loads it in development, and the production image build
# reads it. VITE_* values end up in the browser bundle: never put secrets here.

# Environment: development or production (production on the VPS)
VITE_APP_ENV=development

# Origin of the API.
# Development: http://localhost:50001 (the browser calls the API's published port).
# Production (VPS): leave empty, so the browser calls /api/ on the same origin through Nginx.
VITE_API_BASE_URL=http://localhost:50001
