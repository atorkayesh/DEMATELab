# Main DNS names; nginx also redirects the corresponding www names.
PROXY_DEMATELAB_HOST=dematelab.example.com
PROXY_PCK_HOST=policycoherence.example.com
# Directory on the Docker host, and filenames inside it. Use a certificate covering all four names.
PROXY_CERT_DIR=/path/to/certificates
PROXY_TLS_CERT=fullchain.pem
PROXY_TLS_KEY=privkey.pem

# Public DNS target (documentation only; not used as a Docker bind address).
PROXY_PUBLIC_IP=192.0.2.10
# Optional: bind ports 80/443 to an IP assigned to this Docker host.
# Leave empty to preserve Docker's default all-interface binding.
PROXY_BIND_IP=
