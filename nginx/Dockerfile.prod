FROM nginx:stable-alpine

# The image's entrypoint renders templates into /etc/nginx/conf.d/ at startup, replacing only
# variables that are set in the environment (nginx's own $host etc. stay). With
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS it sets NGINX_LOCAL_RESOLVERS from /etc/resolv.conf first,
# so the resolver works under both Docker and podman.
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
COPY nginx.prod.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]
